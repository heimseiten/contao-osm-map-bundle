{
    "name": "heimseiten/contao-osm-map-bundle",
    "description": "Inhaltselement für Karten aus OpenStreetMap, ohne Verbindung zu fremden Servern beim Seitenaufruf: Anschrift eintragen, das Kartenbild entsteht beim Speichern und liegt danach im Dateimanager.",
    "keywords": [
        "karte",
        "map",
        "openstreetmap",
        "osm",
        "anfahrt",
        "standorte",
        "datenschutz",
        "dsgvo",
        "google maps",
        "dlh googlemaps",
        "dlh_googlemaps"
    ],
    "type": "contao-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "heimseiten.de - Webdesign aus Köln",
            "email": "info@heimseiten.de",
            "homepage": "https://www.heimseiten.de/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/heimseiten/contao-osm-map-bundle/issues",
        "source": "https://github.com/heimseiten/contao-osm-map-bundle"
    },
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "contao/core-bundle": "^5.3",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "Heimseiten\\ContaoOsmMapBundle\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "contao-community-alliance/composer-plugin": true
        }
    },
    "extra": {
        "contao-manager-plugin": "Heimseiten\\ContaoOsmMapBundle\\ContaoManager\\Plugin"
    }
}
