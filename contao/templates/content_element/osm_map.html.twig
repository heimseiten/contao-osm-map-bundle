{% extends "@Contao/content_element/_base.html.twig" %}
{% use "@Contao/component/_figure.html.twig" %}

{#
    Zweite Fassung für schmale Bildschirme.

    Ein breites, flaches Kartenbild wird auf dem Telefon entweder sehr klein oder es zeigt
    nach dem Zuschneiden die Umgebung statt des Ortes. Deshalb entsteht beim Speichern auf
    Wunsch ein zweites Bild in eigenem Format (meist quadratisch), und der Browser sucht
    sich die passende Fassung selbst aus.

    Umgesetzt als zusätzliche Quellen IM selben <picture>, nicht als zweites Bild mit
    „display:none": Ein ausgeblendetes zweites <img> würde trotzdem geladen — beide Bilder
    also übertragen, obwohl nur eines zu sehen ist. Die schmalen Quellen stehen VOR den
    übrigen, denn der Browser nimmt die erste, deren Bedingung zutrifft.
#}
{% block picture_component %}
    {% if bild_schmal|default(false) %}
        {% set schmal_media = '(max-width: ' ~ schmal_bis ~ 'px)' %}
        <picture>
            {# Erst die modernen Formate (AVIF, WebP) der schmalen Fassung … #}
            {% for quelle in bild_schmal.image.sources %}
                {% set schmal_attribute = attrs()
                    .set('srcset', quelle.srcset)
                    .setIfExists('sizes', quelle.sizes|default)
                    .setIfExists('type', quelle.type|default)
                    .set('media', quelle.media|default ? schmal_media ~ ' and ' ~ quelle.media : schmal_media)
                    .setIfExists('width', quelle.width|default)
                    .setIfExists('height', quelle.height|default)
                %}
                <source{{ schmal_attribute }}>
            {% endfor %}

            {# … dann dieselbe Fassung im Grundformat, als Rückfallebene. #}
            {% set schmal_bild = bild_schmal.image.img %}
            {% set schmal_attribute = attrs()
                .set('srcset', schmal_bild.srcset is defined and schmal_bild.srcset ? schmal_bild.srcset : schmal_bild.src)
                .setIfExists('sizes', schmal_bild.sizes|default)
                .set('media', schmal_media)
                .setIfExists('width', schmal_bild.width|default)
                .setIfExists('height', schmal_bild.height|default)
            %}
            <source{{ schmal_attribute }}>

            {# Darunter die gewohnten Quellen des breiten Bildes und das <img> selbst. #}
            {% if figure.image.sources %}{{ block('sources') }}{% endif %}
            {{ block('image') }}
        </picture>
        {{ block('schema_org') }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{#
    Karte aus OpenStreetMap.

    Das Bild liegt fertig auf dem eigenen Server — beim Aufruf der Seite wird nichts
    nachgeladen. Der Balken am unteren Bildrand ist HTML und kein Teil des Bildes: nur so
    lassen sich einzelne Wörter verlinken, und der Text bleibt lesbar und übersetzbar.
#}

{# Die Gestaltung kommt aus dem Bundle und wird nur geladen, wenn eine Karte auf der
   Seite steht. Eigene Anpassungen gehören ins Theme — die Regeln dort gewinnen, weil sie
   später geladen werden. #}
{% block style %}
    {% add "osm_map_css" to stylesheets %}
        <link rel="stylesheet" href="{{ asset("osm-map.css", "heimseiten_contao_osm_map") }}">
    {% endadd %}
    {# Bewegliche Karte: Das Skript lädt MapLibre erst, wenn eine Karte ins Bild kommt. #}
    {% if interaktiv|default(null) %}
        {% add "osm_map_interaktiv_js" to body %}
            <script type="module" src="{{ asset("osm-map-interaktiv.js", "heimseiten_contao_osm_map") }}"></script>
        {% endadd %}
    {% endif %}
{% endblock %}

{% block content %}
    {% if hinweis %}
        <p class="osm-map__hinweis">{{ hinweis }}</p>
    {% elseif bild %}
        <div class="osm-map{% if dunkel|default(false) %} osm-map--dunkel{% endif %}{% if interaktiv|default(null) %} osm-map--interaktiv{% endif %}"
             {%- if interaktiv|default(null) %} data-osm-interaktiv="{{ interaktiv|json_encode }}"{% endif %}>
            {% if verlinken %}
                <a href="{{ link }}" class="osm-map__flaeche" title="{{ link_titel }}" target="_blank" rel="noopener">
                    {% with {figure: bild} %}{{ block('figure_component') }}{% endwith %}
                </a>
            {% else %}
                {% with {figure: bild} %}{{ block('figure_component') }}{% endwith %}
            {% endif %}

            {% if balken %}
                <p class="osm-map__balken">
                    {%- for teil in balken -%}
                        {%- if teil.typ == 'link' -%}
                            <a href="{{ teil.ziel }}" target="_blank" rel="noopener" data-dienst="{{ teil.dienst }}">{{ teil.text }}</a>
                        {%- else -%}
                            {{ teil.text }}
                        {%- endif -%}
                    {%- endfor -%}
                </p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
